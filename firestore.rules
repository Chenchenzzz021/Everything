rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== Everything: mỗi nhóm tối đa 20 người, chỉ thành viên mới đọc được vị trí và địa điểm =====
    function isMember(c) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/doita/$(c)).data.members;
    }
    // hồ sơ của từng tài khoản: tên hiển thị và mã nhóm đang ở
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /doita/{c} {
      allow get: if request.auth != null;            // phải biết mã mới đọc được
      allow list: if false;                           // không ai liệt kê được các cặp
      allow create: if request.auth != null && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && request.resource.data.members.size() <= 20 && (
        request.auth.uid in resource.data.members ||
        (resource.data.members.size() < 20 &&
         request.resource.data.members == resource.data.members.concat([request.auth.uid]))
      );
      allow delete: if false;
      match /loc/{uid} {
        allow read: if isMember(c);
        allow write: if isMember(c) && request.auth.uid == uid;
      }
      match /places/{pid} {
        allow read, write: if isMember(c);
      }
      // ảnh: chỉ người có tên trong "see" mới xem được; chỉ người đăng mới sửa/xoá
      match /photos/{pid} {
        allow read: if isMember(c) && request.auth.uid in resource.data.see;
        allow create: if isMember(c) && request.resource.data.by == request.auth.uid
                      && request.auth.uid in request.resource.data.see
                      && request.resource.data.img.size() < 900000;
        allow update: if isMember(c) && resource.data.by == request.auth.uid
                      && request.resource.data.by == request.auth.uid;
        allow delete: if isMember(c) && resource.data.by == request.auth.uid;
        // bình luận và thả cảm xúc: ai xem được ảnh thì được bình luận
        function canSee(c, pid) {
          return isMember(c) && request.auth.uid in get(/databases/$(database)/documents/doita/$(c)/photos/$(pid)).data.see;
        }
        match /cmts/{cid} {
          allow read: if canSee(c, pid);
          allow create: if canSee(c, pid) && request.resource.data.by == request.auth.uid;
          allow delete: if isMember(c) && resource.data.by == request.auth.uid;
        }
        match /re/{uid} {
          allow read: if canSee(c, pid);
          allow write: if canSee(c, pid) && request.auth.uid == uid;
        }
      }
      // tin nhắn riêng: mã cuộc trò chuyện = uid1_uid2, chỉ 2 người đó đọc/ghi
      // Trò chơi: ca rô, cá ngựa
      match /games/{gid} {
        allow read: if isMember(c);
        allow create: if isMember(c) && request.resource.data.by == request.auth.uid && request.resource.data.pl == [request.auth.uid];
        allow update: if isMember(c) && (request.auth.uid in resource.data.pl || request.auth.uid in resource.data.inv);
        allow delete: if isMember(c) && resource.data.by == request.auth.uid;
      }
      // Vị trí riêng cho từng người xem (khi ẩn với một số người)
      match /lv/{lid} {
        allow read: if isMember(c) && (request.auth.uid == resource.data.v || request.auth.uid == resource.data.o);
        allow create, update: if isMember(c) && request.resource.data.o == request.auth.uid && lid == request.auth.uid + '_' + request.resource.data.v;
        allow delete: if isMember(c) && lid.split('_')[0] == request.auth.uid;
      }
      match /chats/{pid} {
        allow get: if isMember(c) && request.auth.uid in pid.split('_');
        allow list: if isMember(c) && request.auth.uid in resource.data.m;
        allow write: if isMember(c) && request.auth.uid in pid.split('_') && request.resource.data.m == pid.split('_');
        match /msgs/{mid} {
          allow read: if isMember(c) && request.auth.uid in pid.split('_');
          allow create: if isMember(c) && request.auth.uid in pid.split('_') && request.resource.data.by == request.auth.uid;
          allow delete: if isMember(c) && resource.data.by == request.auth.uid;
        }
      }
    }
  }
}
